		<view name="v_clients" >
			<comment><![CDATA[VIEW]]></comment>
			<view_script><![CDATA[CREATE VIEW ${nameWithSchemaName} AS select `cl`.`id` AS `clientId`,`cl`.`completeName` AS `clientName`,`co`.`name` AS `countryName`,`co`.`idCardName` AS `idCardName`,`cl`.`idCardNumber` AS `idCardNumber`,`co`.`idCardFormat` AS `idCardFormat`,`cl`.`emailAddress` AS `emailAddress`,`cl`.`phoneNumber` AS `phoneNumber`,`co`.`mobilePhoneFormat` AS `mobilePhoneFormat`,`co`.`phonePrefix` AS `phonePrefix`,`co`.`phoneDigitsToRemove` AS `phoneDigitsToRemove`,`cl`.`hasImported` AS `hasImported`,`cl`.`comments` AS `comments`,`cl`.`isContractSigned` AS `isContractSigned`,`cl`.`contractFile` AS `contractFile`,`cl`.`createDate` AS `createDate` from (`fcrm`.`client` `cl` join `fcrm`.`country` `co` on(`co`.`id` = `cl`.`countryId`))]]></view_script>
			<column name="clientId" type="BIGINT" />
			<column name="clientName" type="VARCHAR" />
			<column name="countryName" type="VARCHAR" />
			<column name="idCardName" type="VARCHAR" />
			<column name="idCardNumber" type="VARCHAR" />
			<column name="idCardFormat" type="VARCHAR" />
			<column name="emailAddress" type="VARCHAR" />
			<column name="phoneNumber" type="VARCHAR" />
			<column name="mobilePhoneFormat" type="VARCHAR" />
			<column name="phonePrefix" type="VARCHAR" />
			<column name="phoneDigitsToRemove" type="INT" />
			<column name="hasImported" type="BIT" />
			<column name="comments" type="VARCHAR" />
			<column name="isContractSigned" type="BIT" />
			<column name="contractFile" type="VARCHAR" />
			<column name="createDate" type="DATETIME" />
		</view>
	</schema>
